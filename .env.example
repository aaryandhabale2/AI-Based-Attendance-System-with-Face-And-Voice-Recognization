# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-me-to-a-long-random-secret

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./attendance.db

# ─── Faculty Auth ─────────────────────────────────────────────────────────────
# JWT tokens expire after this many minutes
JWT_EXPIRE_MINUTES=480

# ─── Attendance Thresholds ────────────────────────────────────────────────────
FACE_SIMILARITY_THRESHOLD=0.45
VOICE_SIMILARITY_THRESHOLD=0.75
MSE_ELIGIBILITY_THRESHOLD=55.0   # percentage

# ─── SMS Provider ─────────────────────────────────────────────────────────────
# Options: mock | fast2sms | twilio | msg91
SMS_PROVIDER=mock

# Fast2SMS (set SMS_PROVIDER=fast2sms and fill this)
FAST2SMS_API_KEY=

# Twilio (set SMS_PROVIDER=twilio and fill these)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 (set SMS_PROVIDER=msg91 and fill these)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=ATTEND

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
